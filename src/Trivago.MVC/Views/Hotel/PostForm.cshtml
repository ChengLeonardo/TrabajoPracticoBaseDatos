@model Trivago.MVC.Models.HotelViewModel

@{
    ViewData["Title"] = "Alta de Hotel";
}

<div class="container my-5 text-light">
    <h1 class="text-info mb-3">@ViewData["Title"]</h1>
    <p>Agregar un hotel nuevo</p>

    <form asp-action="PostForm" method="post" class="bg-dark p-4 rounded-4 border border-secondary shadow-sm">
        <div class="mb-3">
            <input asp-for="@Model.hotelPostViewModel.nombre" placeholder="Ingrese el nombre del hotel"
                   class="form-control bg-secondary text-light border-1 border-secondary" />
        </div>
        <div class="mb-3">
            <input asp-for="@Model.hotelPostViewModel.Direccion" placeholder="Ingrese la dirección del hotel"
                   class="form-control bg-secondary text-light border-1 border-secondary" />
        </div>
        <div class="mb-3">
            <input asp-for="@Model.hotelPostViewModel.Telefono" placeholder="Ingrese el número de teléfono"
                type="number" class="form-control bg-secondary text-light border-1 border-secondary" />
        </div>
        <div class="mb-3">
            <input asp-for="@Model.hotelPostViewModel.URL" placeholder="Ingrese la URL del hotel"
                   class="form-control bg-secondary text-light border-1 border-secondary" />
        </div>
        <div class="mb-3">
            <select asp-for="@Model.hotelPostViewModel.IdCiudadSeleccionado" asp-items="@Model.hotelPostViewModel.ciudades"
                    class="form-select bg-secondary text-light border-1 border-secondary">
            </select>
        </div>

        <input type="hidden" asp-for="@Model.hotelGetViewModel.hoteles" value="@Model.hotelGetViewModel.hoteles.ToList()" />

        <button type="submit" class="btn btn-info">➕ Alta Hotel</button>
    </form>

    <a asp-action="Index" class="btn btn-outline-light mt-3">🏨 Mostrar Hoteles</a>
</div>

