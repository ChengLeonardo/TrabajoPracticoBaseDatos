@using Trivago.Core.Ubicacion
@model Trivago.Core.Ubicacion.Hotel

@{
    ViewData["Title"] = "Detalle de Hotel";
}

<div class="container my-5 text-light bg-dark p-4 rounded-4 shadow-lg border border-secondary">
    <h1 class="mb-4 text-info">@ViewData["Title"]</h1>

    <div class="card bg-secondary text-light mb-4 border-0 shadow-sm p-3">
        <p><strong>Ciudad:</strong> @Model.ciudad.nombre</p>
        <p><strong>Nombre:</strong> @Model.Nombre</p>
        <p><strong>Teléfono:</strong> @Model.Telefono</p>
        <p><strong>URL:</strong> <a href="@Model.URL" class="text-info">@Model.URL</a></p>
    </div>

    <h4 class="mb-3">Habitaciones</h4>
    <div class="list-group mb-4">

        @foreach(var habitacion in Model.Habitaciones)
        {
            <a class="list-group-item list-group-item-action bg-dark text-light border-secondary hover-overlay"
               asp-controller="Habitacion" asp-action="Detalle" asp-route-id="@habitacion.idHabitacion">
                🛏️ @habitacion.tipoHabitacion.Nombre @habitacion.nroHabitacion
            </a>
        }
    </div>

    <div class="d-flex gap-3">
        <a asp-action="Index" class="btn btn-outline-light btn-sm">🏨 Mostrar hoteles</a>
        @if(User.IsInRole("Admin"))
        {
            <a asp-action="PostForm" class="btn btn-success btn-sm">➕ Agregar hotel</a>
            <a asp-controller="Habitacion" asp-action="PostForm" asp-route-idHotel="@Model.idHotel" class="btn btn-primary btn-sm">➕ Agregar habitación</a>
        }
    </div>
</div>

