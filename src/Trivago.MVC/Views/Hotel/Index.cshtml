@model Trivago.MVC.Models.HotelViewModel

@{
    ViewData["Title"] = "Hoteles";
}

<div class="container my-5 text-light">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="text-info mb-0">@ViewData["Title"]</h1>
        <a asp-action="PostForm" class="btn btn-success btn-sm">➕ Agregar hotel</a>
    </div>

    <div class="list-group">
        @foreach(var hotel in Model.hotelGetViewModel.hoteles)
        {
            <a class="list-group-item list-group-item-action bg-dark text-light border-secondary hover-overlay"
               asp-action="Detalle" asp-route-id="@hotel.idHotel">
                🏨 @hotel.Nombre
            </a>
        }
    </div>
</div>

