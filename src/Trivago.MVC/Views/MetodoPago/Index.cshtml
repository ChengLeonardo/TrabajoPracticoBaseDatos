@model Trivago.MVC.Models.MetodoPagoViewModel

@{
    ViewData["Title"] = "Métodos de Pago";
}

<div class="container my-5 text-light">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="text-info mb-0">@ViewData["Title"]</h1>
        @if(User.IsInRole("Admin"))
        {   
            <a asp-action="PostForm" class="btn btn-success btn-sm">➕ Agregar Método de Pago</a>
        }
    </div>

    <div class="list-group">
        @foreach(var metodoPago in Model.metodoPagoGetViewModel.metodoPagos)
        {
            <a class="list-group-item list-group-item-action bg-dark text-light border-secondary hover-overlay"
               asp-action="Detalle" asp-route-id="@metodoPago.idMetodoPago">
                💳 @metodoPago.TipoMedioPago
            </a>
        }
    </div>
</div>

