@using Trivago.Core.Ubicacion
@model Trivago.Core.Ubicacion.MetodoPago

@{
    ViewData["Title"] = "Detalle de MetodoPago";
}

<div class="container my-5 text-light bg-dark p-4 rounded-4 shadow-lg border border-secondary">
    <h1 class="mb-4 text-info">@ViewData["Title"]</h1>

    <div class="card bg-secondary text-light mb-4 border-0 shadow-sm p-3">
        <p><strong>Tipo de Medio de Pago:</strong> @Model.TipoMedioPago</p>
    </div>

    <h4 class="mb-3">Reservas asociadas</h4>
    <div class="list-group mb-4">
        @foreach(var reserva in Model.Reservas)
        {
            <a class="list-group-item list-group-item-action bg-dark text-light border-secondary hover-overlay"
               asp-controller="Reserva" asp-action="Detalle" asp-route-id="@reserva.idReserva">
                📄 Reserva #@reserva.idReserva
            </a>
        }
    </div>

    <div class="d-flex gap-3">
        <a asp-action="Index" class="btn btn-outline-light btn-sm">🔙 Mostrar Metodo Pago</a>
        <a asp-action="PostForm" class="btn btn-success btn-sm">➕ Agregar Metodo Pago</a>
    </div>
</div>

