@using Trivago.Core.Ubicacion
@model Trivago.Core.Ubicacion.Ciudad

@{
    ViewData["Title"] = "Detalle";
}

<div class="container my-5 text-light bg-dark p-4 rounded-4 shadow-lg border border-secondary">
    <h1 class="mb-4 text-info">@ViewData["Title"]</h1>

    <div class="card bg-secondary text-light mb-4 shadow-sm border-0">
        <div class="card-body">
            <h5 class="card-title text-warning">Nombre de ciudad</h5>
            <p class="card-text fs-5">@Model.nombre</p>
        </div>
    </div>

    <h4 class="mb-3 text-light">Hoteles</h4>

    <div class="list-group mb-4">
        @foreach (var hotel in Model.Hoteles)
        {
            <a class="list-group-item list-group-item-action bg-dark text-light border-secondary hover-overlay"
               asp-action="Detalle"
               asp-controller="Hotel"
               asp-route-id="@hotel.idHotel">
                🏨 @hotel.Nombre
            </a>
        }
    </div>

    <div class="d-flex gap-3">
        <a asp-action="Index" class="btn btn-outline-light btn-sm">🏙️ Mostrar ciudades</a>
        <a asp-action="PostForm" class="btn btn-success btn-sm">➕ Agregar ciudad</a>
        <a asp-controller="Hotel" asp-action="PostForm" asp-route-idCiudad="@Model.idCiudad" class="btn btn-primary btn-sm">🏨 Agregar hotel</a>
    </div>
</div>
