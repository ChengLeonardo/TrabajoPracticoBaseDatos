
@model Trivago.MVC.Models.CiudadViewModel;
@{
    ViewData["Title"] = "PostForm";
}

<h1>@ViewData["Title"]</h1>
<p>Agregar una ciudad nueva</p>
<form asp-action="PostForm" method="post">
    <input asp-for="@Model.ciudadPostViewModel.nombre" placeholder="Ingrese el nombre de la ciudad">
    <select asp-for="@Model.ciudadPostViewModel.IdPaisSeleccionado" asp-items="@Model.ciudadPostViewModel.paises">
        <option disabled selected>--Elegir un pais--</option>
    </select>
    <input hidden asp-for"@Model.ciudadGetViewModel.ciudades" value="@Model.ciudadGetViewModel.ciudades">
    <button type="submit">Alta Ciudad</button>
</form>
<a asp-action="Index"></a>
