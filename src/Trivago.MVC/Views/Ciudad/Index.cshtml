@model Trivago.MVC.Models.CiudadViewModel;
@{
    ViewData["Title"] = "Index";
}

<h1>@ViewData["Title"]</h1>
@foreach(var ciudad in Model.ciudadGetViewModel.ciudades)
{
<div class="row">
    <div class="col">
        <a asp-action="Detalle" asp-route-id="@ciudad.idCiudad">@ciudad.nombre</a>
    </div>
</div>
}
<a asp-action="PostForm">Agregar ciudad</a>

