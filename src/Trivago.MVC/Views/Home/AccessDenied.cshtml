@{
    ViewData["Title"] = "Acceso Denegado";
    Layout = "_Layout"; // usa el layout global
}

<div class="container d-flex justify-content-center align-items-center vh-100">
    <div class="bg-dark text-light p-5 rounded-4 shadow-lg border border-secondary text-center" style="max-width: 500px;">
        <h1 class="text-danger mb-3">🚫 Acceso Denegado</h1>
        <p class="mb-4">No tenés permisos para acceder a esta página.</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-info">🏠 Volver al Inicio</a>
        <div class="mt-3">
            <a asp-controller="Usuario" asp-action="Login" class="text-info text-decoration-none">🔑 Iniciar sesión con otra cuenta</a>
        </div>
    </div>
</div>
