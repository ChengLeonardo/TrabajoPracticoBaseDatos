@using System.ComponentModel.DataAnnotations.Schema
@using Microsoft.AspNetCore.Mvc.ModelBinding
@using Trivago.Core.Ubicacion
@model HomeViewModel
@using Trivago.MVC

@{
    ViewData["Title"] = "Home Page";
}

<div class="container my-5 text-light">
    <!-- Formulario de búsqueda -->
    <form asp-action="Index" method="post" class="mb-5">
        <div class="d-flex gap-2 p-3 bg-dark rounded border border-secondary align-items-center">
            <input type="hidden" asp-for="@Model.homePostViewModel.LugaresDato" value="@Model.homePostViewModel.LugaresDato" />

            <select asp-for="@Model.homePostViewModel.id" asp-items="@Model.homePostViewModel.Lugares" class="form-select bg-secondary text-light border-0"></select>

            <button type="submit" class="btn btn-info">🔍 Buscar</button>
        </div>
    </form>

    <!-- Información de columnas -->
    <div class="row text-center">
        <div class="col mb-4">
            <img src="https://imgcy.trivago.com/hardcodedimages/homepage-landing/usp/SearchDesktop.svg" class="mb-3" />
            <h3 class="text-warning">Buscá rápido</h3>
            <p>Buscá fácilmente entre millones de hoteles en segundos.</p>
        </div>
        <div class="col mb-4">
            <img src="https://imgcy.trivago.com/hardcodedimages/homepage-landing/usp/CompareDesktop.svg" class="mb-3" />
            <h3 class="text-warning">Compará con confianza</h3>
            <p>Compará precios de hoteles de más de 100 páginas a la vez.</p>
        </div>
        <div class="col mb-4">
            <img src="https://imgcy.trivago.com/hardcodedimages/homepage-landing/usp/SaveDesktop.svg" class="mb-3" />
            <h3 class="text-warning">Ahorrá a lo grande</h3>
            <p>Encontrá grandes ofertas en nuestras páginas asociadas.</p>
        </div>
    </div>
</div>
