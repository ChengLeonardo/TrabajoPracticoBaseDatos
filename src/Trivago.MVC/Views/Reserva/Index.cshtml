@model Trivago.MVC.Models.ReservaViewModel

@{
    ViewData["Title"] = "Reservas";
}

<div class="container my-5 text-light">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="text-info mb-0">@ViewData["Title"]</h1>
        @if(!User.IsInRole("Hotel"))
        {
            <a asp-action="PostForm" class="btn btn-success btn-sm">➕ Agregar reserva</a>
        }
    </div>

    <div class="list-group">
        @foreach(var reserva in Model.reservaGetViewModel.Reservas)
        {
            <a class="list-group-item list-group-item-action bg-dark text-light border-secondary hover-overlay"
               asp-action="Detalle" asp-route-id="@reserva.idReserva">
                📄 Reserva #@reserva.idReserva
            </a>
        }
    </div>
</div>
